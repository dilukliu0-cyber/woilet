# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://ваш-проект.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — необязательно. Без него приложение просто соберётся
# без крэш-мониторинга.
EXPO_PUBLIC_SENTRY_DSN=

# Ключ Gemini в этот файл НЕ кладётся: он живёт только на сервере,
# иначе его можно вытащить из приложения. Задаётся секретом Supabase:
#   supabase secrets set GEMINI_API_KEY=...
